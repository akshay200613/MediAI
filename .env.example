# =============================================================================
# MedAI – Environment Configuration Template
# Copy this file to .env.local for local development
# =============================================================================

# --- App ---
APP_NAME="MedAI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_HOST="0.0.0.0"
API_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# --- PostgreSQL ---
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="medai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
DATABASE_URL="postgresql+asyncpg://postgres:changeme@localhost:5432/medai"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_PREFIX="medai"

# --- JWT Auth ---
JWT_SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google AI / Gemini (Primary) ---
GEMINI_API_KEY="your-google-api-key"
# Primary Model Routing
MODEL_RECEPTION="gemini/gemini-2.0-flash"
MODEL_MEDICAL="gemini/gemini-2.0-flash"
MODEL_SCHEDULING="gemini/gemini-2.0-flash"
MODEL_KNOWLEDGE="gemini/gemini-2.0-flash"
MODEL_SUPERVISOR="gemini/gemini-2.0-flash"

# --- Groq Fallback ---
GROQ_API_KEY="your-groq-api-key"
MODEL_FALLBACK_RECEPTION="groq/llama-3.1-8b-instant"
MODEL_FALLBACK_MEDICAL="groq/llama-3.3-70b-versatile"
MODEL_FALLBACK_SCHEDULING="groq/llama-3.1-8b-instant"
MODEL_FALLBACK_KNOWLEDGE="groq/llama-3.3-70b-versatile"
MODEL_FALLBACK_SUPERVISOR="groq/llama-3.3-70b-versatile"

# --- LiteLLM Router ---
LITELLM_NUM_RETRIES=2
LITELLM_REQUEST_TIMEOUT=30
LITELLM_CACHE_ENABLED=true

GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# --- LangSmith Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="your-langchain-api-key"
LANGCHAIN_PROJECT="mediai"

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="MedAI"
NEXT_PUBLIC_APP_VERSION="0.1.0"
