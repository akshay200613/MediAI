# =============================================================================
# MedAI – Environment Configuration Template
# Copy this file to .env.local for local development
# =============================================================================

# --- App ---
APP_NAME="MedAI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_HOST="0.0.0.0"
API_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# --- PostgreSQL ---
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="medai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
DATABASE_URL="postgresql+asyncpg://postgres:changeme@localhost:5432/medai"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_PREFIX="medai"

# --- JWT Auth ---
JWT_SECRET_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_IN_PRODUCTION"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google AI / Gemini ---
GOOGLE_API_KEY="your-google-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="MedAI"
NEXT_PUBLIC_APP_VERSION="0.1.0"
