# =============================================================================
# MedAI - Production / VM Environment (TEMPLATE - committed to git)
#
#   On the VM:  cp .env.example .env   (then fill in real values)
#   .env is gitignored - never commit it, never copy it to dev machines.
#
# What belongs here: SECRETS + values that differ per environment.
# LLM models, retries and RAG tuning live in core/config/settings.py,
# so the VM and local dev always run the same models.
#
# Used by: docker-compose.yml (or deployment/vm/docker-compose.yml)
# For local development use .env.local (see .env.local.example).
# =============================================================================

# --- App ---
ENVIRONMENT="production"
DEBUG=false
ALLOWED_ORIGINS='["https://your-domain.com"]'   # JSON list

# --- PostgreSQL ---
# Host/port are set by docker compose (postgres:5432). Use a strong password.
POSTGRES_DB="medai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="generate-a-strong-random-password"

# --- Redis ---
REDIS_PASSWORD=""

# --- Qdrant (Vector DB, e.g. Qdrant Cloud) ---
QDRANT_HOST="your-qdrant-host"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# --- JWT Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="generate-a-long-random-secret"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Admin bootstrap ---
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="generate-a-strong-admin-password"

# --- LLM API keys ---
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"

# --- LangSmith Observability ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="your-langchain-api-key"
LANGCHAIN_PROJECT="mediai"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
