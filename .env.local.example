# =============================================================================
# MedAI – Local Development Environment
# Copy this file: cp .env.local.example .env.local
# Then fill in your real API keys below.
# This file is gitignored — never commit it.
# =============================================================================

# --- App ---
APP_NAME="MedAI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_HOST="0.0.0.0"
API_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# --- PostgreSQL ---
# Note: Inside Docker, the host is "postgres" (set automatically by docker-compose)
# For running the API outside Docker (make dev), use "localhost"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="medai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
DATABASE_URL="postgresql+asyncpg://postgres:changeme@localhost:5432/medai"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# --- Qdrant (Vector DB) ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_PREFIX="medai"

# --- JWT Auth ---
JWT_SECRET_KEY="local-dev-secret-change-this-before-any-deployment"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google AI / Gemini ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
MODEL_RECEPTION="gemini/gemini-2.0-flash"
MODEL_MEDICAL="gemini/gemini-2.0-flash"
MODEL_SCHEDULING="gemini/gemini-2.0-flash"
MODEL_KNOWLEDGE="gemini/gemini-2.0-flash"
MODEL_SUPERVISOR="gemini/gemini-2.0-flash"

# --- Groq Fallback ---
# Get your key at: https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"
MODEL_FALLBACK_RECEPTION="groq/llama-3.1-8b-instant"
MODEL_FALLBACK_MEDICAL="groq/llama-3.3-70b-versatile"
MODEL_FALLBACK_SCHEDULING="groq/llama-3.1-8b-instant"
MODEL_FALLBACK_KNOWLEDGE="groq/llama-3.3-70b-versatile"
MODEL_FALLBACK_SUPERVISOR="groq/llama-3.3-70b-versatile"

# --- LiteLLM Router ---
LITELLM_NUM_RETRIES=2
LITELLM_REQUEST_TIMEOUT=30
LITELLM_CACHE_ENABLED=false

GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# --- LangSmith Observability (optional for local dev) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="mediai-local"

# --- RAG Pipeline ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="MedAI"
NEXT_PUBLIC_APP_VERSION="0.1.0"
