# =============================================================================
# MedAI â€“ Local Development Environment (TEMPLATE â€“ committed to git)
#
#   Copy:  cp .env.local.example .env.local   (then fill in real values)
#   .env.local is gitignored â€” never commit it.
#
# What belongs here: SECRETS + values that differ per environment.
# What does NOT belong here: LLM models, retries, RAG tuning, etc.
#   â†’ those live in core/config/settings.py so local == VM, always.
#   (You *can* still override any setting here temporarily, e.g. MODEL_MEDICAL=...,
#    but don't leave overrides in place.)
#
# Used by:
#   - docker compose (deployment/local/docker-compose.local.yml)
#   - native runs (uvicorn / pytest) via core/config/settings.py
# =============================================================================

# --- App ---
ENVIRONMENT="development"
DEBUG=true
# ALLOWED_ORIGINS defaults to localhost:3000/8000 (see settings.py)

# --- PostgreSQL ---
# Native runs connect to the Docker Postgres on host port 5433.
# Inside Docker, compose overrides host/port to postgres:5432 automatically.
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="medai"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="choose-a-local-password"
# DATABASE_URL is built automatically from the values above.

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# --- Qdrant (Vector DB) ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_API_KEY=""

# --- JWT Auth (use a different secret from production!) ---
JWT_SECRET_KEY="local-dev-secret-change-me"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Admin bootstrap (optional) ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- LLM API keys (ideally separate dev keys from production) ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Groq:   https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# --- LangSmith Observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="mediai-local"

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
