# =============================================================================
# MediAI Next.js Frontend — Local Development Dockerfile
# Runs Next.js dev server with hot reload (not for production)
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies first (cached layer)
COPY package.json package-lock.json* ./
RUN npm install

# Copy source
COPY . .

EXPOSE 3000

# Dev server with hot reload
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
