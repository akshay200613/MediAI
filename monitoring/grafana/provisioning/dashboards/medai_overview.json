{
  "id": null,
  "uid": "medai-overview",
  "title": "MedAI — System Overview",
  "description": "Real-time monitoring of the MedAI backend: HTTP traffic, authentication, appointments, RAG ingestion, and WebSocket connections.",
  "tags": ["medai", "fastapi", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Total Requests (1h)",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] }, "unit": "short" }
      },
      "targets": [{ "expr": "sum(increase(medai_http_requests_total[1h])) or vector(0)", "legendFormat": "Requests" }]
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "Error Rate (5xx)",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "unit": "percentunit",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      },
      "targets": [{
        "expr": "(sum(rate(medai_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(medai_http_requests_total[5m]))) or vector(0)",
        "legendFormat": "5xx rate"
      }]
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "Active WebSocket Connections",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }
        }
      },
      "targets": [{ "expr": "sum(medai_websocket_connections_active) or vector(0)", "legendFormat": "Active connections" }]
    },
    {
      "id": 5,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Appointments Booked (24h)",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{ "expr": "sum(increase(medai_appointment_bookings_total{outcome=\"success\"}[24h])) or vector(0)", "legendFormat": "Booked" }]
    },
    {
      "id": 6,
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "type": "stat",
      "title": "Double-booking Conflicts (24h)",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] }
        }
      },
      "targets": [{ "expr": "sum(increase(medai_appointment_bookings_total{outcome=\"conflict\"}[24h])) or vector(0)", "legendFormat": "Conflicts" }]
    },
    {
      "id": 16,
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "type": "stat",
      "title": "Successful Logins (24h)",
      "datasource": "Prometheus",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "noValue": "0", "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "targets": [{ "expr": "sum(increase(medai_auth_login_total{outcome=\"success\"}[24h])) or vector(0)", "legendFormat": "Logins" }]
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries",
      "title": "HTTP Request Rate by Status",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum by(status) (rate(medai_http_requests_total[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "timeseries",
      "title": "HTTP Latency Percentiles (p50 / p95 / p99)",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le) (rate(medai_http_request_duration_seconds_bucket[5m]))) or vector(0)", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(medai_http_request_duration_seconds_bucket[5m]))) or vector(0)", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le) (rate(medai_http_request_duration_seconds_bucket[5m]))) or vector(0)", "legendFormat": "p99" }
      ]
    },
    {
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "type": "timeseries",
      "title": "Appointment Bookings (success vs conflict)",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by(outcome) (rate(medai_appointment_bookings_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 17,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "type": "timeseries",
      "title": "Appointment Cancellations by Role",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by(role) (rate(medai_appointment_cancellations_total[5m]))", "legendFormat": "{{role}}" }
      ]
    },
    {
      "id": 13,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "type": "timeseries",
      "title": "WebSocket Connections by Role",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "medai_websocket_connections_active", "legendFormat": "{{role}}" }
      ]
    },
    {
      "id": 18,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "type": "timeseries",
      "title": "Auth Login Attempts by Outcome",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by(outcome) (rate(medai_auth_login_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 19,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "type": "timeseries",
      "title": "RAG Document Ingestion by Outcome",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum by(outcome) (rate(medai_rag_ingest_total[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 20,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "type": "timeseries",
      "title": "RAG Chunks Indexed per Ingestion (p95)",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by(le) (rate(medai_rag_chunks_indexed_bucket[5m]))) or vector(0)", "legendFormat": "p95 chunks" }
      ]
    },
    {
      "id": 15,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "type": "table",
      "title": "Top Slowest Endpoints (p95 latency)",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "noValue": "No requests", "unit": "s" } },
      "options": { "sortBy": [{ "desc": true, "displayName": "p95" }] },
      "targets": [{
        "expr": "topk(10, histogram_quantile(0.95, sum by(handler, le) (rate(medai_http_request_duration_seconds_bucket[5m]))))",
        "legendFormat": "{{handler}}",
        "instant": true
      }]
    }
  ]
}
